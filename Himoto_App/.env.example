# Local mobile API backend settings. Copy to .env and fill with TEST credentials.
# Never use the production database for automated write tests.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@POOLER_HOST:6543/postgres
MANAGEMENT_SESSION_SECRET=REPLACE_WITH_A_STABLE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# true enables new web and mobile password sign-ins; false blocks new sign-ins.
LOGIN_MODE=true

# Optional provider integrations; fill only when running their sandbox checks.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VIDEO_STORAGE_PROVIDER=cloudinary
CLOUDFLY_S3_ENDPOINT=https://s3.cloudfly.vn
CLOUDFLY_S3_REGION=hn
CLOUDFLY_S3_BUCKET=himoto-videos
CLOUDFLY_S3_ACCESS_KEY_ID=
CLOUDFLY_S3_SECRET_ACCESS_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_MODE=test
SEPAY_SERVICE_USER_ID=
ZALO_REMINDER_WEBHOOK_URL=
