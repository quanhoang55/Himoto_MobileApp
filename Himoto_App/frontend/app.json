{
  "expo": {
    "name": "HIMOTO",
    "slug": "himoto-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "himoto",
    "plugins": ["expo-router", "expo-secure-store"],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.himoto.mobile",
      "predictiveBackGestureEnabled": true
    }
  }
}
